# Hono API base URL — server-side only, used by +page.server.ts loaders.
# In dev: points to local Hono API (apps/api/ running on port 3000).
# In production: points to the deployed Hono API URL.
API_URL=http://localhost:3000

# Optional: public URL of the deployed frontend itself, used for
# canonical links, OpenGraph tags, and sitemap generation. Leave
# unset for dev; required for production builds.
PUBLIC_SITE_URL=http://localhost:5173
